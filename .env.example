# All default casting, sentiment and neural speech are free and run locally.
PANEL_USE_EXTERNAL_VISION=0
# Optional: enable vision-assisted character continuity and voice design.
# Without a key, native PDF text / local OCR and tentative visual matching work offline.
PANEL_VISION_KEY=
PANEL_VISION_MODEL=gpt-4o-mini
# Store this on a persistent volume in production.
PANEL_DATA_DIR=.data
# Optional when hosting the frontend on a different origin (comma-separated exact origins).
PANEL_ALLOWED_ORIGINS=
# Official Kokoro weights are installed here by the production image.
PANEL_MODEL_DIR=/opt/panel-models
